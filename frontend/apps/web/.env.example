# LabCore ELIS Web Frontend Environment Variables
# Public API Endpoint for Next.js
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_CLIENT_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Note: NEVER put database credentials, private keys, or service role secrets in this file.
# Only NEXT_PUBLIC_ variables are bundled and exposed to the browser client.
