{
  "name": "labcore-elis-backend-fixed",
  "version": "3.0.0",
  "description": "LabCore ELIS & Hospital Information System - Advanced Doctor & Pathology Module",
  "main": "index.js",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "start:dev": "npm --prefix backend run start:dev",
    "build": "npm run build:backend",
    "build:all": "npm run build:backend && npm run build:portal && npm run build:web",
    "build:backend": "npm --prefix backend run build",
    "build:web": "npm --prefix frontend/apps/web run build",
    "build:portal": "npm --prefix login-portal run build",
    "typecheck": "npm --prefix backend run typecheck",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "deploy:migrate": "npm --prefix backend run deploy:migrate",
    "verify:prod": "node scripts/verify-production.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js --env production",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "test": "npm --prefix backend test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/jsbarcode": "^3.11.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsbarcode": "^3.12.3",
    "mongoose": "^8.3.4"
  },
  "keywords": [
    "elis",
    "lims",
    "hospital-management",
    "doctor-module",
    "pathology",
    "cpoe",
    "prescription",
    "delta-check",
    "panic-alerts"
  ],
  "author": "LabCore Health Informatics",
  "license": "ISC",
  "type": "commonjs"
}
