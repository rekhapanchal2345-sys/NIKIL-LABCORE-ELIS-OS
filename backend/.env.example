# ─── Required ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/labcore_elis"

# Signing key for access and refresh tokens. At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=labcore-api
JWT_AUDIENCE=labcore-web

# Encrypts values stored in the database. Must be separate from JWT_SECRET so
# rotating the signing key cannot make stored secrets unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=

# HMAC key for the one-time codes emailed for password reset and verification.
# Without a key, codes in a stolen database could be brute-forced.
EMAIL_CODE_SECRET=

BCRYPT_ROUNDS=12
# Server-side HMAC pepper applied BEFORE bcrypt.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_PEPPER=
GST_PERCENTAGE=18

# ─── Session and confirmation policy ─────────────────────────────────────
SESSION_TTL_DAYS=7
IDLE_TIMEOUT_MINUTES=30
IDLE_TIMEOUT_ADMIN_MINUTES=20
MAX_CONCURRENT_SESSIONS=2
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_MAX=100

# Roles that must complete an authenticator challenge at every sign-in.
MFA_REQUIRED_ROLES=ADMIN,SUPER_ADMIN,BRANCH_ADMIN

# Lifetime of the token issued after an administrator re-enters their password.
OWNER_TOKEN_EXPIRES_IN=5m

# One-time code policy for email verification and password reset.
EMAIL_CODE_TTL_MINUTES=15
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_RATE_LIMIT_MAX=5
EMAIL_CODE_VERIFY_LIMIT_MAX=10

# ─── Networking ──────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3001
# Comma-separated origins allowed in production. Leave empty in development only.
CORS_ORIGINS=
# Number of reverse proxies in front of the API, so X-Forwarded-For is trusted
# only as far as it really goes and req.ip cannot be spoofed.
TRUST_PROXY_HOPS=0

# ─── Email (Gmail) ───────────────────────────────────────────────────────
# Gmail requires an App Password: Google Account -> Security -> 2-Step
# Verification -> App passwords. The account password will not work here.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=LabCore Enterprise LIS

# ─── SMS ─────────────────────────────────────────────────────────────────
SMS_PROVIDER=custom
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# ─── WhatsApp ────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=twilio
WHATSAPP_API_KEY=
WHATSAPP_API_SECRET=
WHATSAPP_SENDER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_API_VERSION=v19.0
# Shared secret ABDM/Twilio signs webhook requests with. Without it, anyone who
# finds the webhook URL can post fake consent and health-data requests.
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ─── Calls ───────────────────────────────────────────────────────────────
CALL_PROVIDER=custom
CALL_API_KEY=
CALL_API_SECRET=
CALL_CALLER_ID=

# ─── Backup encryption ───────────────────────────────────────────────────
# Encrypts database dumps. At least 32 characters.
ENCRYPTION_SECRET=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_CRON=0 2 * * *

# ─── Retention and compliance ────────────────────────────────────────────
DATA_RETENTION_YEARS=7
AUDIT_LOG_RETENTION_DAYS=365
AUTO_ARCHIVE_ENABLED=true
AUTO_ARCHIVE_SCHEDULE=0 3 * * *

# ─── Seed administrator ──────────────────────────────────────────────────
# Used only by the create-admin / reset-admin scripts. There is no default: the
# scripts refuse to run without these so a published password cannot be created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_EMPLOYEE_CODE=ADMIN001

# ─── Seed staff (create-users script) ─────────────────────────────────────
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_FULL_NAME=
SEED_USER_EMPLOYEE_CODE=JAY001

# =============================================================
# ABDM (Ayushman Bharat Digital Mission) Configuration
# =============================================================

# Set to "false" to connect to the real ABDM sandbox/production gateway.
# Default is "true" — all ABDM calls are simulated locally (no NHA dependency).
ABDM_MOCK_MODE=true

# "sandbox" | "production"
ABDM_ENV=sandbox

# NHA-issued credentials (required when ABDM_MOCK_MODE=false)
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# Your NHA-registered HIP (Health Information Provider) ID
ABDM_HIP_ID=TEST_HIP_001

# HIU ID (optional — for Health Information User role)
ABDM_HIU_ID=

# Public HTTPS URL where ABDM Gateway will POST webhook callbacks
# Must be publicly reachable (use ngrok / reverse proxy in development)
ABDM_CALLBACK_URL=https://your-lab-domain.com/api/abdm/v0.5

# Lab / Facility metadata (used in FHIR DiagnosticReport bundles)
LAB_NAME=LabCore Diagnostics
LAB_REGISTRATION_NUMBER=
LAB_NABL_NUMBER=
LAB_ADDRESS=
LAB_PHONE=
# 2-letter ISO 3166-2:IN state code e.g. MH, DL, GJ, TN
LAB_STATE_CODE=MH
