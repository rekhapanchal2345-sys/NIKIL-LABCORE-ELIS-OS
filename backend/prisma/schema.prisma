generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                        @id @default(cuid())
  employeeCode                 String                        @unique
  fullName                     String
  email                        String                        @unique
  phone                        String?                       @db.VarChar(15)
  passwordHash                 String
  role                         UserRole
  status                       AccountStatus                 @default(ACTIVE)
  specialization               String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  autoApproveResults           Boolean                       @default(false)
  compactMode                  Boolean                       @default(false)
  darkMode                     Boolean                       @default(false)
  dateFormat                   String?                       @default("DD/MM/YYYY")
  defaultReportTemplate        String?                       @default("standard")
  department                   String?
  designation                  String?
  emergencyContact             String?
  emergencyContactPhone        String?                       @db.VarChar(15)
  enableCriticalAlerts         Boolean                       @default(true)
  enableDailyDigest            Boolean                       @default(true)
  enableEmailNotifications     Boolean                       @default(true)
  enablePushNotifications      Boolean                       @default(true)
  enableSmsNotifications       Boolean                       @default(false)
  firstName                    String?
  language                     String?                       @default("English")
  lastName                     String?
  preferredCommunicationMethod String?                       @default("email")
  profileImage                 String?
  showTutorial                 Boolean                       @default(true)
  signature                    String?
  timeFormat                   String?                       @default("24h")
  timezone                     String?                       @default("Asia/Kolkata")
  workingHoursEnd              String?                       @default("17:00")
  workingHoursStart            String?                       @default("09:00")
  failedLoginCount             Int                           @default(0)
  lockedUntil                  DateTime?
  passwordChangedAt            DateTime?
  mfaEnabled                   Boolean                       @default(false)
  totpSecretEnc                String?
  totpPendingEnc               String?
  /// Confirmed by a code sent to this Gmail address. Until then the account can
  /// sign in but cannot be trusted for credential recovery.
  emailVerified                Boolean                       @default(false)
  emailVerifiedAt              DateTime?
  /// SHA-256 of the canonical address. Lets "is this the same mailbox?" be
  /// answered without storing the address a second time.
  emailBlindIndex              String?
  /// Set once a sign-in from a device we have not seen before is alerted to the
  /// account owner, so the alert is not repeated on every subsequent sign-in.
  lastAlertedDeviceFingerprint String?
  lastAlertedIpAddress         String?
  createdTestMappings          AnalyzerTestMapping[]         @relation("TestMappingCreator")
  approvals                    Approval[]                    @relation("ApprovalUser")
  auditLogs                    AuditLog[]
  createdCalibrations          Calibration[]                 @relation("CalibrationCreator")
  counterSessions              CashCounterSession[]          @relation("CounterSessionUser")
  cashCounters                 CashCounter[]                 @relation("CounterAssigned")
  cashMovements                CashMovement[]                @relation("CashMovementPerformer")
  sentCommunications           CommunicationLog[]            @relation("CommunicationSender")
  criticalAcknowledgments      CriticalValueAcknowledgment[]
  createdMaintenances          Maintenance[]                 @relation("MaintenanceCreator")
  mfaBackupCodes               MfaBackupCode[]
  createdTemplates             NotificationTemplate[]        @relation("TemplateCreator")
  createdOrders                Order[]                       @relation("OrderCreator")
  passwordHistory              PasswordHistory[]
  advancesReceived             PatientAdvance[]              @relation("AdvanceReceiver")
  consentsCollected            PatientConsent[]              @relation("ConsentCollector")
  historyEntries               PatientHistoryEntry[]         @relation("HistoryEntryCreator")
  createdPatients              Patient[]                     @relation("PatientCreator")
  patientKycVerifications      Patient[]                     @relation("PatientKycVerifier")
  paymentAuditLogs             PaymentAuditLog[]             @relation("PaymentAuditUser")
  paymentsReceived             Payment[]                     @relation("PaymentReceiver")
  createdQCRules               QCRule[]                      @relation("QCRuleCreator")
  reconciliationRecords        ReconciliationRecord[]        @relation("ReconciliationPerformer")
  refundApprovals              RefundApproval[]
  refundsProcessed             Refund[]                      @relation("RefundProcessor")
  refundsRequested             Refund[]                      @relation("RefundRequester")
  createdAddendums             ReportAddendum[]              @relation("AddendumCreator")
  createdShareLinks            ReportShareLink[]             @relation("ShareLinkCreator")
  publishedReports             Report[]                      @relation("ReportPublisher")
  createdAmendments            ResultAmendment[]             @relation("AmendmentCreator")
  approvedAmendments           ResultAmendment[]             @relation("AmendmentApprover")
  approvedResults              Result[]                      @relation("ApprovedBy")
  enteredResults               Result[]                      @relation("EnteredBy")
  verifiedResults              Result[]                      @relation("VerifiedBy")
  performedTrackingEvents      SampleTrackingHistory[]       @relation("TrackingPerformer")
  collectedSamples             Sample[]                      @relation("SampleCollector")
  sessions                     UserSession[]
  emailTokens                  EmailVerificationToken[]
  loginAlerts                  LoginAlert[]
  createdAutoReplyRules        WhatsAppAutoReplyRule[]       @relation("AutoReplyCreator")
  createdCampaigns             WhatsAppCampaign[]            @relation("CampaignCreator")
  createdTriggers              WhatsAppNotificationTrigger[] @relation("TriggerCreator")
  createdWhatsAppTemplates     WhatsAppTemplate[]            @relation("WhatsAppTemplateCreator")
  createdScheduledMessages     WhatsAppScheduledMessage[]   @relation("ScheduledMessageCreator")

  @@index([role])
  @@index([status])
  @@index([fullName])
  @@index([emailBlindIndex])
  @@map("users")
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model UserSession {
  id                String    @id @default(cuid())
  userId            String
  refreshTokenHash  String    @unique
  deviceFingerprint String?
  userAgent         String?
  ipAddress         String?
  lastSeenAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokeReason      String?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_backup_codes")
}

/// Single-use codes emailed to a Gmail address, used for address verification
/// and for password resets. Only the hash is stored, so a database copy cannot
/// be replayed as a live code.
model EmailVerificationToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  codeHash  String
  attempts  Int              @default(0)
  maxAttempts Int            @default(5)
  expiresAt DateTime
  consumedAt DateTime?
  ipAddress String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

enum EmailTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// A record of a sign-in or a credential change that the account owner should
/// know about. Written for every event that is emailed as an alert.
model LoginAlert {
  id                String   @id @default(cuid())
  userId            String?
  type              String
  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?
  emailSent         Boolean  @default(false)
  detail            String?
  createdAt         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("login_alerts")
}

model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}

model Doctor {
  id                     String      @id @default(cuid())
  doctorCode             String      @unique
  fullName               String
  qualification          String?
  specialization         String?
  phone                  String?     @db.VarChar(15)
  email                  String?     @unique
  clinicName             String?
  address                String?
  commissionRate         Decimal?    @db.Decimal(5, 2)
  isActive               Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  availableDays          String?
  availableTime          String?
  consultationFee        Decimal?    @db.Decimal(10, 2)
  department             String?
  designation            String?
  experience             Int?
  licenseExpiry          DateTime?
  licenseNumber          String?
  photoUrl               String?
  signatureUrl           String?
  doctorType             DoctorType? @default(REFERRING_DOCTOR)
  clinicAddress          String?     @db.VarChar(500)
  whatsappNumber         String?     @db.VarChar(15)
  reportDeliveryEmail    Boolean     @default(false)
  reportDeliveryWhatsApp Boolean     @default(false)
  reportDeliveryHardCopy Boolean     @default(false)
  reportDeliveryPortal   Boolean     @default(false)
  enablePortalAccess     Boolean     @default(false)
  bankAccountNumber      String?     @db.VarChar(30)
  bankIfscCode           String?     @db.VarChar(20)
  bankAccountHolderName  String?     @db.VarChar(200)
  registrationNumber     String?

  // ---------- Personal ----------
  title                  String?     @db.VarChar(20)
  gender                 String?     @db.VarChar(20)
  dateOfBirth            DateTime?
  languages              String?     @db.VarChar(300)
  experienceYears        Int?
  notes                  String?

  // ---------- Contact / Address ----------
  city                   String?     @db.VarChar(100)
  state                  String?     @db.VarChar(100)
  pincode                String?     @db.VarChar(10)

  // ---------- Regulatory / Statutory ----------
  panNumber              String?     @db.VarChar(10)
  gstin                  String?     @db.VarChar(15)
  registrationCouncil    String?     @db.VarChar(100)
  registrationExpiry     DateTime?
  registrationCertificateUrl String?

  // ---------- Financial / Commission ----------
  commissionType         CommissionType @default(PERCENTAGE)
  commissionFlatAmount   Decimal?    @db.Decimal(10, 2)
  commissionCategoryRules Json?
  payoutCycle            PayoutCycle @default(MONTHLY)
  upiId                  String?     @db.VarChar(100)
  bankName               String?     @db.VarChar(150)
  cancelledChequeUrl     String?

  // ---------- Organisation (Hospital / Clinic partner) ----------
  organizationId         String?

  // ---------- Digital signature governance ----------
  signatureApprovedAt    DateTime?
  signatureApprovedById  String?

  // ---------- Soft delete / Archive ----------
  isArchived             Boolean     @default(false)
  archivedAt             DateTime?
  archivedById           String?
  archiveReason          String?     @db.VarChar(500)

  orders                 Order[]
  patients               Patient[]
  organization           DoctorOrganization?  @relation(fields: [organizationId], references: [id])
  commissionLedger       DoctorCommissionEntry[]
  payouts                DoctorPayout[]
  documents              DoctorDocument[]

  @@index([fullName])
  @@index([specialization])
  @@index([isActive])
  @@index([doctorType])
  @@index([city])
  @@index([organizationId])
  @@index([isArchived])
  @@index([registrationNumber])
  @@index([phone], map: "doctors_phone_idx")
  @@map("doctors")
}

// =======================================================
// DOCTOR ORGANIZATION (Hospital / Clinic / Lab partner)
// =======================================================

model DoctorOrganization {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  organizationType OrganizationType @default(CLINIC)
  contactPerson  String?  @db.VarChar(200)
  phone          String?  @db.VarChar(15)
  email          String?
  address        String?
  city           String?  @db.VarChar(100)
  state          String?  @db.VarChar(100)
  pincode        String?  @db.VarChar(10)
  gstin          String?  @db.VarChar(15)
  panNumber      String?  @db.VarChar(10)
  commissionRate Decimal? @db.Decimal(5, 2)
  payoutCycle    PayoutCycle @default(MONTHLY)
  bankAccountNumber String? @db.VarChar(30)
  bankIfscCode   String?  @db.VarChar(20)
  bankAccountHolderName String? @db.VarChar(200)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  doctors        Doctor[]

  @@index([name])
  @@index([organizationType])
  @@map("doctor_organizations")
}

// =======================================================
// DOCTOR COMMISSION LEDGER
// One row per PAID order -> commission earned.
// Single source of truth for "Pending vs Settled".
// =======================================================

model DoctorCommissionEntry {
  id               String   @id @default(cuid())
  doctorId         String
  orderId          String
  payoutId         String?
  referralDate     DateTime @default(now())
  periodKey        String   @db.VarChar(7) // YYYY-MM
  baseAmount       Decimal  @db.Decimal(12, 2)
  commissionRate   Decimal  @db.Decimal(5, 2)
  commissionType   CommissionType @default(PERCENTAGE)
  commissionAmount Decimal  @db.Decimal(12, 2)
  status           CommissionStatus @default(PENDING)
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  doctor           Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payout           DoctorPayout? @relation(fields: [payoutId], references: [id])

  @@unique([orderId])
  @@index([doctorId, status])
  @@index([periodKey])
  @@index([payoutId])
  @@map("doctor_commission_entries")
}

// =======================================================
// DOCTOR PAYOUTS (settlement vouchers)
// =======================================================

model DoctorPayout {
  id            String   @id @default(cuid())
  voucherNumber String   @unique
  doctorId      String
  grossAmount   Decimal  @db.Decimal(12, 2)
  tdsPercentage Decimal  @default(0) @db.Decimal(5, 2)
  tdsAmount     Decimal  @default(0) @db.Decimal(12, 2)
  netPaid       Decimal  @db.Decimal(12, 2)
  paymentMode   String   @db.VarChar(30)
  refNumber     String?
  payoutDate    DateTime
  periodKey     String?  @db.VarChar(7)
  remarks       String?
  status        CommissionStatus @default(SETTLED)
  settledById   String?
  createdAt     DateTime @default(now())
  doctor        Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  entries       DoctorCommissionEntry[]

  @@index([doctorId])
  @@index([payoutDate])
  @@map("doctor_payouts")
}

// =======================================================
// DOCTOR DOCUMENTS (registration certificate, cheque ...)
// =======================================================

model DoctorDocument {
  id           String   @id @default(cuid())
  doctorId     String
  documentType String   @db.VarChar(60)
  fileName     String?  @db.VarChar(255)
  mimeType     String?  @db.VarChar(120)
  sizeBytes    Int?
  fileData     String?
  uploadedById String?
  createdAt    DateTime @default(now())
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("doctor_documents")
}

model Patient {
  id                           String                     @id @default(cuid())
  uhid                         String                     @unique
  firstName                    String
  lastName                     String
  gender                       Gender
  dateOfBirth                  DateTime?
  age                          Int?
  ageMonth                     Int?
  ageDay                       Int?
  phone                        String?                    @db.VarChar(15)
  email                        String?
  bloodGroup                   String?
  address                      String?
  city                         String?
  state                        String?
  pincode                      String?                    @db.VarChar(10)
  emergencyContact             String?                    @db.VarChar(15)
  referredById                 String?
  createdById                  String?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  emergencyContactName         String?
  emergencyContactRelationship String?
  fastingStatus                String?
  insuranceNumber              String?
  insuranceProvider            String?
  nationalId                   String?
  isActive                     Boolean                    @default(true)
  middleName                   String?
  alternatePhone               String?                    @db.VarChar(15)
  landmark                     String?
  country                      String?                    @default("India")
  emergencyContactAddress      String?
  height                       Float?
  weight                       Float?
  bmi                          Float?
  aadhaarNumber                String?                    @db.VarChar(12)
  panNumber                    String?                    @db.VarChar(10)
  patientType                  String?                    @default("GENERAL")
  maritalStatus                String?
  occupation                   String?
  nationality                  String?                    @default("Indian")
  allergies                    Json?
  chronicDiseases              Json?
  currentMedications           Json?
  insuranceGroupNumber         String?
  insuranceExpiryDate          DateTime?
  photoUrl                     String?
  preferredLanguage            String?                    @default("ENGLISH")
  preferredCommunicationMethod String?
  communicationPreference      Json?
  consentForTreatment          Boolean                    @default(false)
  consentForDataSharing        Boolean                    @default(false)
  consentForMarketing          Boolean                    @default(false)
  familyHeadId                 String?
  relationshipToHead           String?
  notes                        String?
  isDraft                      Boolean                    @default(false)
  registrationSource           String?                    @default("WALK_IN")
  referralSource               String?
  verificationStatus           String?                    @default("UNVERIFIED")
  phoneVerified                Boolean                    @default(false)
  emailVerified                Boolean                    @default(false)
  kycVerified                  Boolean                    @default(false)
  qrCode                       String?
  abhaNumber                   String?                    @db.VarChar(20)
  abhaAddress                  String?                    @db.VarChar(100)
  healthIdNumber               String?                    @db.VarChar(20)
  aadhaarReferenceToken        String?                    // Encrypted
  abhaStatus                   String                     @default("UNLINKED")
  abhaLinkedAt                 DateTime?
  formStep                     Int?
  formProgress                 Int?
  lastEditedSection            String?
  kycVerifiedAt                DateTime?
  kycVerifiedById              String?
  abdm_care_contexts           abdm_care_contexts[]
  abdm_consents                abdm_consents[]
  communications               CommunicationLog[]
  orders                       Order[]
  advances                     PatientAdvance[]
  consents                     PatientConsent[]           @relation("PatientConsents")
  historyEntries               PatientHistoryEntry[]      @relation("PatientHistory")
  medicalHistories             PatientMedicalHistory[]    @relation("PatientMedicalHistories")
  verifications                PatientVerification[]      @relation("PatientVerifications")
  wallet                       PatientWallet?
  createdBy                    User?                      @relation("PatientCreator", fields: [createdById], references: [id])
  familyHead                   Patient?                   @relation("FamilyHead", fields: [familyHeadId], references: [id])
  familyMembers                Patient[]                  @relation("FamilyHead")
  kycVerifiedBy                User?                      @relation("PatientKycVerifier", fields: [kycVerifiedById], references: [id])
  referredBy                   Doctor?                    @relation(fields: [referredById], references: [id])
  reports                      Report[]
  results                      Result[]                   @relation("ResultPatient")
  trackingHistory              SampleTrackingHistory[]
  samples                      Sample[]
  whatsappConversations        WhatsAppConversation[] @relation("ConversationPatient")
  whatsappIncomingMessages     WhatsAppIncomingMessage[]
  whatsappScheduledMessages    WhatsAppScheduledMessage[]

  @@index([phone])
  @@index([firstName, lastName])
  @@index([referredById])
  @@index([createdById])
  @@index([familyHeadId])
  @@index([isDraft])
  @@index([isActive])
  @@index([createdAt])
  @@index([abhaNumber])
  @@index([abhaAddress])
  @@index([kycVerifiedById])
  @@map("patients")
}

model TestCategory {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   String?
  color        String?  @default("#3B82F6")
  icon         String?
  displayOrder Int?     @default(0)
  tests        Test[]

  @@index([name])
  @@index([department])
  @@index([isActive])
  @@map("test_categories")
}

model Test {
  id                       String            @id @default(cuid())
  testCode                 String            @unique
  testName                 String
  categoryId               String?
  sampleType               SampleType
  sampleContainer          String?
  method                   String?
  price                    Decimal           @db.Decimal(10, 2)
  gstPercentage            Decimal           @default(0) @db.Decimal(5, 2)
  tatHours                 Int               @default(24)
  isActive                 Boolean           @default(true)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  shortName                String?
  sampleVolume             String?
  processingDepartment     String?
  offerPrice               Decimal?          @db.Decimal(10, 2)
  b2bRate                  Decimal?          @db.Decimal(10, 2)
  tatDisplay               String?
  displayOrder             Int?              @default(0)
  clinicalSignificance     String?
  patientPreparation       String?
  deltaCheckAbsThreshold   Decimal?          @db.Decimal(10, 2)
  deltaCheckEnabled        Boolean           @default(false)
  deltaThresholdPercentage Decimal?          @db.Decimal(5, 2)
  description              String?
  orderItems               OrderItem[]
  results                  Result[]
  samples                  Sample[]
  packageItems             TestPackageItem[]
  parameters               TestParameter[]
  category                 TestCategory?     @relation(fields: [categoryId], references: [id])

  @@index([testName])
  @@index([categoryId])
  @@index([sampleType])
  @@index([isActive])
  @@map("tests")
}

model TestParameter {
  id                      String                        @id @default(cuid())
  testId                  String
  parameterName           String
  loincCode               String?
  unit                    String?
  dataType                ParameterType
  displayOrder            Int                           @default(1)
  isRequired              Boolean                       @default(true)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  shortName               String?
  measurementMethod       String?
  dropdownOptions         String?
  allowRichText           Boolean                       @default(false)
  decimalPrecision        Int?
  isActive                Boolean                       @default(true)
  criticalAcknowledgments CriticalValueAcknowledgment[]
  referenceRanges         ReferenceRange[]
  resultValues            ResultValue[]
  test                    Test                          @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([parameterName])
  @@map("test_parameters")
}

model ReferenceRange {
  id             String        @id @default(cuid())
  parameterId    String
  gender         Gender?
  minAge         Int?
  maxAge         Int?
  criticalLow    Decimal?      @db.Decimal(10, 2)
  normalLow      Decimal?      @db.Decimal(10, 2)
  normalHigh     Decimal?      @db.Decimal(10, 2)
  criticalHigh   Decimal?      @db.Decimal(10, 2)
  interpretation String?
  createdAt      DateTime      @default(now())
  ageGroup       String?
  minAgeUnit     String?
  maxAgeUnit     String?
  notes          String?
  isActive       Boolean       @default(true)
  displayOrder   Int?          @default(0)
  updatedAt      DateTime      @updatedAt
  parameter      TestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@index([parameterId])
  @@index([ageGroup])
  @@index([gender])
  @@index([isActive])
  @@map("reference_ranges")
}

model TestPackage {
  id                 String            @id @default(cuid())
  packageCode        String            @unique
  packageName        String
  description        String?
  totalPrice         Decimal           @db.Decimal(10, 2)
  offerPrice         Decimal?          @db.Decimal(10, 2)
  discountPercentage Decimal?          @db.Decimal(5, 2)
  gstPercentage      Decimal           @default(0) @db.Decimal(5, 2)
  includesTestsCount Int               @default(0)
  tatHours           Int               @default(24)
  tatDisplay         String?
  targetAudience     String?
  recommendedFor     String?
  isActive           Boolean           @default(true)
  isPopular          Boolean           @default(false)
  displayOrder       Int?              @default(0)
  color              String?           @default("#10B981")
  icon               String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  orderItems         OrderItem[]
  items              TestPackageItem[]

  @@index([packageName])
  @@index([isActive])
  @@index([isPopular])
  @@map("test_packages")
}

model TestPackageItem {
  id           String      @id @default(cuid())
  packageId    String
  testId       String
  testPrice    Decimal     @db.Decimal(10, 2)
  discount     Decimal     @default(0) @db.Decimal(10, 2)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  package      TestPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  test         Test        @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([packageId, testId])
  @@index([packageId])
  @@index([testId])
  @@map("test_package_items")
}

model Order {
  id                     String                  @id @default(cuid())
  orderNumber            String                  @unique
  barcode                String                  @unique
  patientId              String
  doctorId               String?
  createdById            String?
  orderStatus            OrderStatus             @default(REGISTERED)
  paymentStatus          PaymentStatus           @default(PENDING)
  sampleCollected        Boolean                 @default(false)
  collectedAt            DateTime?
  reportedAt             DateTime?
  notes                  String?
  subtotal               Decimal                 @default(0) @db.Decimal(10, 2)
  discount               Decimal                 @default(0) @db.Decimal(10, 2)
  gstAmount              Decimal                 @default(0) @db.Decimal(10, 2)
  grandTotal             Decimal                 @default(0) @db.Decimal(10, 2)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  collectionType         String?
  discountCode           String?
  dueAmount              Decimal                 @default(0) @db.Decimal(10, 2)
  homeCollectionAddress  String?
  paidAmount             Decimal                 @default(0) @db.Decimal(10, 2)
