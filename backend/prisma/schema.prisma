  @@index([patientId])
  @@index([status])
}

model abdm_transactions {
  id            String   @id
  requestId     String   @unique
  correlationId String?
  apiEndpoint   String?
  transactionId String?
  action        String
  status        String   @default("INITIATED")
  patientId     String?
  requestData   Json?
  responseData  Json?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([patientId])
  @@index([status])
}

model accounting_sequences {
  id             String    @id @default(cuid()) @db.VarChar(255)
  sequenceName   String    @map("series_type") @db.VarChar(50)
  financialYear  String    @map("financial_year") @db.VarChar(20)
  branchId       String    @default("DEFAULT") @map("branch_id") @db.VarChar(100)
  prefix         String?   @db.VarChar(50)
  currentValue   Int       @default(0) @map("current_value")
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sequenceName, financialYear, branchId], map: "unique_series_fy_branch")
  @@map("accounting_sequences")
}

