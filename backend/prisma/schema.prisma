model Order {
  id                     String                  @id @default(cuid())
  orderNumber            String                  @unique
  barcode                String                  @unique
  patientId              String
  doctorId               String?
  createdById            String?
  orderStatus            OrderStatus             @default(REGISTERED)
  paymentStatus          PaymentStatus           @default(PENDING)
  sampleCollected        Boolean                 @default(false)
  collectedAt            DateTime?
  reportedAt             DateTime?
  notes                  String?
  subtotal               Decimal                 @default(0) @db.Decimal(10, 2)
  discount               Decimal                 @default(0) @db.Decimal(10, 2)
  gstAmount              Decimal                 @default(0) @db.Decimal(10, 2)
  grandTotal             Decimal                 @default(0) @db.Decimal(10, 2)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  collectionType         String?
  discountCode           String?
  dueAmount              Decimal                 @default(0) @db.Decimal(10, 2)
  homeCollectionAddress  String?
  paidAmount             Decimal                 @default(0) @db.Decimal(10, 2)
  priority               String?                 @default("ROUTINE")
  reportDeliveryEmail    Boolean                 @default(false)
  reportDeliveryPortal   Boolean                 @default(false)
  reportDeliveryPrinted  Boolean                 @default(false)
  reportDeliveryWhatsApp Boolean                 @default(false)
  clinicalNotes          String?
  fastingStatus          String?
  reportId               String?                 @unique
  specimenType           String?
  encounterType          EncounterType?          @default(OPD)
  wardName               String?
  roomNumber             String?
  bedNumber              String?
  nurseStationId         String?
  invoice                Invoice?
  items                  OrderItem[]
  createdBy              User?                   @relation("OrderCreator", fields: [createdById], references: [id])
  doctor                 Doctor?                 @relation(fields: [doctorId], references: [id])
  patient                Patient                 @relation(fields: [patientId], references: [id])
  payments               Payment[]
  reports                Report[]
  results                Result[]
  trackingHistory        SampleTrackingHistory[]
  samples                Sample[]
  commissionEntries       DoctorCommissionEntry[]

  @@index([patientId])
  @@index([doctorId])
  @@index([createdById])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            String       @id @default(cuid())
  orderId       String
  testId        String?
  price         Decimal      @db.Decimal(10, 2)
  discount      Decimal      @default(0) @db.Decimal(10, 2)
  gstPercentage Decimal      @default(0) @db.Decimal(5, 2)
  gstAmount     Decimal      @default(0) @db.Decimal(10, 2)
  finalPrice    Decimal      @db.Decimal(10, 2)
  createdAt     DateTime     @default(now())
  packageId     String?
  itemType      String       @default("TEST")
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  package       TestPackage? @relation(fields: [packageId], references: [id])
  test          Test?        @relation(fields: [testId], references: [id])

  @@index([orderId])
  @@index([testId])
  @@index([packageId])
  @@index([itemType])
  @@map("order_items")
}

model Sample {
  id              String                  @id @default(cuid())
  sampleNumber    String                  @unique
  barcode         String                  @unique
  patientId       String
  orderId         String
  testId          String
  sampleType      SampleType
  status          SampleStatus            @default(PENDING)
  collectedById   String?
  collectedAt     DateTime?
  receivedAt      DateTime?
  completedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  collectionType  String?
  priority        String?
  trackingHistory SampleTrackingHistory[]
  collectedBy     User?                   @relation("SampleCollector", fields: [collectedById], references: [id])
  /// ISS-014: Changed from onDelete: Cascade to Restrict.
  /// Cascade silently destroyed all physical specimen records when an Order was deleted,
  /// erasing biological custody chain. Restrict forces staff to void samples first through
  /// the proper SampleStatus workflow before an order can be cancelled.
  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  patient         Patient                 @relation(fields: [patientId], references: [id])
  test            Test                    @relation(fields: [testId], references: [id])

  @@index([patientId])
  @@index([orderId])
  @@index([testId])
  @@index([status])
  @@index([collectedById])
  @@map("samples")
}

model SampleTrackingHistory {
  id            String                  @id @default(cuid())
  sampleId      String
  orderId       String
  patientId     String
  eventType     SampleTrackingEventType
  status        String?
  location      String?
  notes         String?
  performedById String?
  performedAt   DateTime                @default(now())
  metadata      Json?
  createdAt     DateTime                @default(now())
  order         Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patient       Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  performedBy   User?                   @relation("TrackingPerformer", fields: [performedById], references: [id])
  sample        Sample                  @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@index([sampleId])
  @@index([orderId])
  @@index([patientId])
  @@index([eventType])
  @@index([performedAt])
  @@map("sample_tracking_history")
}

model Invoice {
