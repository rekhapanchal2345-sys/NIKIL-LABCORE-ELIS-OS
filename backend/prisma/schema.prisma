/// EMPI decision tier returned by the probabilistic scoring engine
enum EmpiDecision {
  /// Score 85-100: block registration and show UI modal
  AUTO_BLOCK_DUPLICATE
  /// Score 60-84: allow registration but flag for data-steward review
  POTENTIAL_DUPLICATE_QUEUE
  /// Score < 60: create a new UHID normally
  DISTINCT_PATIENT
}






