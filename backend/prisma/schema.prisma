enum CultureSampleSite {
  BLOOD
  URINE
  SPUTUM
  PUS_SWAB
  CSF
  STOOL
  BRONCHOALVEOLAR_LAVAGE
  PLEURAL_FLUID
  ASCITIC_FLUID
  TISSUE_BIOPSY
}

enum CultureStatus {
  ACCESSIONED
  PRELIMINARY_GRAM_STAIN
  INCUBATING_24H
  INCUBATING_48H
  ORGANISM_ISOLATED
  AST_IN_PROGRESS
  FINAL_VERIFIED
  NO_GROWTH
  CONTAMINATED
}

enum AstInterpretation {
  S // Susceptible
  I // Intermediate / Susceptible Increased Exposure
  R // Resistant
}

enum MdroFlagType {
  NONE
  MRSA // Methicillin-Resistant Staphylococcus aureus
  VRE  // Vancomycin-Resistant Enterococcus
