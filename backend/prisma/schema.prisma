  invoiceNumber String        @unique
  orderId       String        @unique
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  gstPercent    Decimal       @default(18) @db.Decimal(5, 2)
  gstAmount     Decimal       @db.Decimal(10, 2)
  grandTotal    Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  cgstAmount    Decimal       @default(0) @db.Decimal(10, 2)
  dueDate       DateTime?
  igstAmount    Decimal       @default(0) @db.Decimal(10, 2)
  sgstAmount    Decimal       @default(0) @db.Decimal(10, 2)
  taxableAmount Decimal       @db.Decimal(10, 2)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([paymentStatus])
  @@index([createdAt])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id                 String                  @id @default(cuid())
  receiptNumber      String                  @unique
  orderId            String
  amount             Decimal                 @db.Decimal(10, 2)
  method             PaymentMethod
  status             PaymentStatus           @default(PAID)
  transactionId      String?
  remarks            String?
  receivedById       String?
  paidAt             DateTime                @default(now())
  createdAt          DateTime                @default(now())
  allocationId       String?
  cashDrawerId       String?
  corporateAccountId String?
  counterId          String?
  gatewayProvider    String?
  gatewayReference   String?
  gatewayResponse    Json?
  updatedAt          DateTime                @default(now()) @updatedAt
  utr                String?
  allocation         PaymentAllocation?
  cashDrawer         CashDrawer?             @relation(fields: [cashDrawerId], references: [id])
  corporateAccount   CorporateAccount?       @relation(fields: [corporateAccountId], references: [id])
  counter            CashCounter?            @relation(fields: [counterId], references: [id])
  order              Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedBy         User?                   @relation("PaymentReceiver", fields: [receivedById], references: [id])
  refunds            Refund[]
  settlementItems    SettlementTransaction[]

  @@index([orderId])
  @@index([method])
  @@index([status])
  @@index([receivedById])
  @@index([paidAt])
  @@index([receiptNumber])
  @@index([utr])
  @@index([counterId])
  @@index([corporateAccountId])
  @@map("payments")
}

model Result {
  id                      String                        @id @default(cuid())
  orderId                 String
  testId                  String
  status                  ResultStatus                  @default(PENDING)
  remarks                 String?
  interpretation          String?
  enteredById             String?
  approvedById            String?
  verifiedById            String?
  enteredAt               DateTime?
  verifiedAt              DateTime?
  approvedAt              DateTime?
  publishedAt             DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  patientId               String?
  analyzerUsed            String?
  calibrationStatus       String?
  externalQAScheme        String?
  fastingStatus           String?
  hemolysisLipemia        String?
  internalQCStatus        String?
  methodUsed              String?
  reportConfidenceScore   String?
  sampleCollectionTime    DateTime?
  specimenQuality         String?
  approvals               Approval[]
  criticalAcknowledgments CriticalValueAcknowledgment[]
  amendments              ResultAmendment[]
  values                  ResultValue[]
  approvedBy              User?                         @relation("ApprovedBy", fields: [approvedById], references: [id])
  enteredBy               User?                         @relation("EnteredBy", fields: [enteredById], references: [id])
  verifiedBy              User?                         @relation("VerifiedBy", fields: [verifiedById], references: [id])
  order                   Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patient                 Patient?                      @relation("ResultPatient", fields: [patientId], references: [id])
  test                    Test                          @relation(fields: [testId], references: [id])

  @@unique([orderId, testId])
  @@index([orderId])
