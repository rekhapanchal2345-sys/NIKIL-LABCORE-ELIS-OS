generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                        @id @default(cuid())
  employeeCode                 String                        @unique
  fullName                     String
  email                        String                        @unique
  phone                        String?                       @db.VarChar(15)
  passwordHash                 String
  role                         UserRole
  status                       AccountStatus                 @default(ACTIVE)
  specialization               String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  autoApproveResults           Boolean                       @default(false)
  compactMode                  Boolean                       @default(false)
  darkMode                     Boolean                       @default(false)
  dateFormat                   String?                       @default("DD/MM/YYYY")
  defaultReportTemplate        String?                       @default("standard")
  department                   String?
  designation                  String?
  emergencyContact             String?
  emergencyContactPhone        String?                       @db.VarChar(15)
  enableCriticalAlerts         Boolean                       @default(true)
  enableDailyDigest            Boolean                       @default(true)
  enableEmailNotifications     Boolean                       @default(true)
  enablePushNotifications      Boolean                       @default(true)
  enableSmsNotifications       Boolean                       @default(false)
  firstName                    String?
  language                     String?                       @default("English")
  lastName                     String?
  preferredCommunicationMethod String?                       @default("email")
  profileImage                 String?
  showTutorial                 Boolean                       @default(true)
  signature                    String?
  timeFormat                   String?                       @default("24h")
  timezone                     String?                       @default("Asia/Kolkata")
  workingHoursEnd              String?                       @default("17:00")
  workingHoursStart            String?                       @default("09:00")
  failedLoginCount             Int                           @default(0)
  lockedUntil                  DateTime?
  passwordChangedAt            DateTime?
  mfaEnabled                   Boolean                       @default(false)
  totpSecretEnc                String?
  totpPendingEnc               String?
  lastMfaAt                    DateTime?
  /// Confirmed by a code sent to this Gmail address. Until then the account can
  /// sign in but cannot be trusted for credential recovery.
  emailVerified                Boolean                       @default(false)
  emailVerifiedAt              DateTime?
  /// SHA-256 of the canonical address. Lets "is this the same mailbox?" be
  /// answered without storing the address a second time.
  emailBlindIndex              String?
  /// Set once a sign-in from a device we have not seen before is alerted to the
  /// account owner, so the alert is not repeated on every subsequent sign-in.
  lastAlertedDeviceFingerprint String?
  lastAlertedIpAddress         String?
  createdTestMappings          AnalyzerTestMapping[]         @relation("TestMappingCreator")
  approvals                    Approval[]                    @relation("ApprovalUser")
  auditLogs                    AuditLog[]
  createdCalibrations          Calibration[]                 @relation("CalibrationCreator")
  counterSessions              CashCounterSession[]          @relation("CounterSessionUser")
  cashCounters                 CashCounter[]                 @relation("CounterAssigned")
  cashMovements                CashMovement[]                @relation("CashMovementPerformer")
  sentCommunications           CommunicationLog[]            @relation("CommunicationSender")
  criticalAcknowledgments      CriticalValueAcknowledgment[]
  createdMaintenances          Maintenance[]                 @relation("MaintenanceCreator")
  mfaBackupCodes               MfaBackupCode[]
  createdTemplates             NotificationTemplate[]        @relation("TemplateCreator")
  createdOrders                Order[]                       @relation("OrderCreator")
  passwordHistory              PasswordHistory[]
  advancesReceived             PatientAdvance[]              @relation("AdvanceReceiver")
  consentsCollected            PatientConsent[]              @relation("ConsentCollector")
  historyEntries               PatientHistoryEntry[]         @relation("HistoryEntryCreator")
  createdPatients              Patient[]                     @relation("PatientCreator")
  patientKycVerifications      Patient[]                     @relation("PatientKycVerifier")
  paymentAuditLogs             PaymentAuditLog[]             @relation("PaymentAuditUser")
  paymentsReceived             Payment[]                     @relation("PaymentReceiver")
  createdQCRules               QCRule[]                      @relation("QCRuleCreator")
  reconciliationRecords        ReconciliationRecord[]        @relation("ReconciliationPerformer")
  refundApprovals              RefundApproval[]
  refundsProcessed             Refund[]                      @relation("RefundProcessor")
  refundsRequested             Refund[]                      @relation("RefundRequester")
  createdAddendums             ReportAddendum[]              @relation("AddendumCreator")
  createdShareLinks            ReportShareLink[]             @relation("ShareLinkCreator")
  publishedReports             Report[]                      @relation("ReportPublisher")
  createdAmendments            ResultAmendment[]             @relation("AmendmentCreator")
  approvedAmendments           ResultAmendment[]             @relation("AmendmentApprover")
  approvedResults              Result[]                      @relation("ApprovedBy")
  enteredResults               Result[]                      @relation("EnteredBy")
  verifiedResults              Result[]                      @relation("VerifiedBy")
  performedTrackingEvents      SampleTrackingHistory[]       @relation("TrackingPerformer")
  collectedSamples             Sample[]                      @relation("SampleCollector")
  sessions                     UserSession[]
  emailTokens                  EmailVerificationToken[]
  loginAlerts                  LoginAlert[]
  createdAutoReplyRules        WhatsAppAutoReplyRule[]       @relation("AutoReplyCreator")
  createdCampaigns             WhatsAppCampaign[]            @relation("CampaignCreator")
  createdTriggers              WhatsAppNotificationTrigger[] @relation("TriggerCreator")
  createdWhatsAppTemplates     WhatsAppTemplate[]            @relation("WhatsAppTemplateCreator")
  createdScheduledMessages     WhatsAppScheduledMessage[]   @relation("ScheduledMessageCreator")
  trustedDevices               TrustedDevice[]
  webAuthnCredentials          WebAuthnCredential[]
  permissionOverrides          UserPermissionOverride[] @relation("UserPermissionOverrides")
  roleOverrides                UserRoleOverride[]       @relation("UserRoleOverrides")
  ssoAccounts                  SsoAccount[]
  breakGlassEvents             BreakGlassEvent[]
  digitalSignatures            DigitalSignature[]
  createdApiClients            ApiClient[]              @relation("ApiClientCreator")

  @@index([role])
  @@index([status])
  @@index([fullName])
  @@index([emailBlindIndex])
  @@map("users")
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model UserSession {
  id                String    @id @default(cuid())
  userId            String
  refreshTokenHash  String    @unique
  deviceFingerprint String?
  userAgent         String?
  ipAddress         String?
  lastSeenAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokeReason      String?
  createdAt         DateTime  @default(now())

  /// Refresh token rotation family ID.
  /// All tokens belonging to the same original login share this ID.
  /// If a revoked token from the family is presented (reuse attack),
  /// ALL active sessions in the family are immediately revoked.
  familyId          String?

  /// Risk score assigned at session creation (0–100).
  /// Used for session analytics and post-hoc risk review.
  riskScore         Int       @default(0)

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("user_sessions")
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_backup_codes")
}

model TrustedDevice {
  id                String    @id @default(cuid())
  userId            String
  deviceFingerprint String
  deviceName        String
  trustTokenHash    String    @unique
  ipAddress         String?
  userAgent         String?
  trustedUntil      DateTime
  lastUsedAt        DateTime  @default(now())
  revokedAt         DateTime?
  revokeReason      String?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceFingerprint])
  @@index([trustTokenHash])
  @@map("trusted_devices")
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      BigInt    @default(0)
  deviceName   String?
  transports   String?
  aaguid       String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@map("webauthn_credentials")
}

/// Single-use codes emailed to a Gmail address, used for address verification
/// and for password resets. Only the hash is stored, so a database copy cannot
/// be replayed as a live code.
model EmailVerificationToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  codeHash  String
  attempts  Int              @default(0)
  maxAttempts Int            @default(5)
  expiresAt DateTime
  consumedAt DateTime?
  ipAddress String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

enum EmailTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// A record of a sign-in or a credential change that the account owner should
/// know about. Written for every event that is emailed as an alert.
model LoginAlert {
  id                String   @id @default(cuid())
  userId            String?
  type              String
  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?
  emailSent         Boolean  @default(false)
  detail            String?
  createdAt         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("login_alerts")
}

model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}

/// Phase 3 — Per-user GRANT or DENY override for a single permission.
/// Effect resolution: DENY > GRANT > role baseline.
/// A null expiresAt means the override is permanent until explicitly revoked.
model UserPermissionOverride {
  id         String    @id @default(cuid())
  userId     String
  permission String
  /// "GRANT" adds the permission on top of role baseline.
  /// "DENY"  removes the permission even if the role baseline includes it.
  effect     String    // "GRANT" | "DENY"
  reason     String?
  grantedBy  String
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission, effect])
  @@index([userId])
  @@index([permission])
  @@index([expiresAt])
  @@map("user_permission_overrides")
}

/// Phase 3 — Temporary role assignment for a user.
/// Effective when: revokedAt IS NULL AND validFrom <= now() <= validUntil.
/// Supersedes the user's permanent role for permission resolution during window.
model UserRoleOverride {
  id           String    @id @default(cuid())
  userId       String
  overrideRole String    // UserRole value
  reason       String
  grantedBy    String
  validFrom    DateTime  @default(now())
  validUntil   DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation("UserRoleOverrides", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt, validUntil])
  @@map("user_role_overrides")
}

/// Phase 4 — Enterprise Identity Provider Configuration (OIDC / SAML 2.0).
/// Supports Microsoft Entra ID (Azure AD), Google Workspace, Okta, and Ping Identity.
model SsoProvider {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  protocol          String       // "OIDC" | "SAML"
  issuer            String
  clientId          String
  clientSecret      String?
  metadataUrl       String?
  ssoUrl            String
  tokenUrl          String?
  userInfoUrl       String?
  certificate       String?      // X.509 cert PEM for SAML signature validation
  enabled           Boolean      @default(true)
  domainRestriction String?      // Comma-separated allowed email domains (e.g. "hospital.org,lab.net")
  defaultRole       String       @default("FRONT_DESK")
  roleAttribute     String?      // Attribute/claim name to map to LabCore role
  jitEnabled        Boolean      @default(true) // Just-In-Time provisioning
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  accounts          SsoAccount[]

  @@map("sso_providers")
}

/// Phase 4 — External Identity Provider Link.
/// Links an enterprise IdP subject / NameID to an internal LabCore user account.
model SsoAccount {
  id                String      @id @default(cuid())
  providerId        String
  userId            String
  externalSubjectId String      // IdP sub or NameID
  email             String
  profileData       String?     // Raw JSON claims payload from IdP
  lastLoginAt       DateTime    @default(now())
  createdAt         DateTime    @default(now())

  provider          SsoProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalSubjectId])
  @@index([userId])
  @@index([email])
  @@map("sso_accounts")
}

/// Phase 4 — Clinical Break-Glass Emergency Access Event.
/// Allows audited clinical override for urgent patient care (e.g. ICU, trauma, surgery).
model BreakGlassEvent {
  id                 String    @id @default(cuid())
  userId             String
  targetResourceType String    // "patient" | "result" | "order"
  targetResourceId   String
  reason             String    // Mandatory clinical justification
  tokenHash          String    @unique // SHA-256 hash of emergency token
  status             String    @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "REVOKED"
  expiresAt          DateTime
  reviewedAt         DateTime?
  reviewedBy         String?
  reviewNotes        String?
  approved           Boolean?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime  @default(now())

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([targetResourceType, targetResourceId])
  @@index([status, expiresAt])
  @@map("break_glass_events")
}

/// Phase 4 — SCIM 2.0 API Bearer Tokens for Automated IdP Directory Provisioning.
model ScimToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())

  @@map("scim_tokens")
}

/// Phase 5 — FDA 21 CFR Part 11 Compliant Electronic & Digital Signatures.
/// Provides non-repudiation and cryptographic payload binding for clinical sign-offs.
model DigitalSignature {
  id               String    @id @default(cuid())
  userId           String
  resourceType     String    // "result" | "report" | "order" | "amendment"
  resourceId       String
  meaning          String    // "AUTHORED" | "VERIFIED" | "APPROVED" | "AMENDED"
  reason           String?   // Clinical notes or statement
  dataSnapshotHash String    // SHA-256 digest of normalized payload
  signatureHash    String    // Cryptographic signature digest
  rawPayload       String?   // Serialized canonical JSON snapshot
  ipAddress        String?
  userAgent        String?
  signedAt         DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([signedAt])
  @@map("digital_signatures")
}

/// Phase 5 — OAuth2 Machine-to-Machine (M2M) API Gateway Clients.
/// Enables secure integration for LIS analyzers (Roche, Abbott, Sysmex), HIS, and EMR bridges.
model ApiClient {
  id               String    @id @default(cuid())
  name             String    // e.g. "Roche Cobas 6000 Interface", "Apollo HIS Bridge"
  clientId         String    @unique
  clientSecretHash String
  scopes           String    // Comma-separated list of granted scopes
  ipWhitelist      String?   // Comma-separated allowed IPs/CIDRs
  active           Boolean   @default(true)
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  rateLimit        Int       @default(1000) // requests per hour
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  creator          User      @relation("ApiClientCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([active])
  @@map("api_clients")
}

/// Phase 5 — SIEM & SOC Security Threat Telemetry.
/// Records real-time automated threat detections for SOC export and automated mitigation.
model SecurityThreatAlert {
  id               String    @id @default(cuid())
  threatType       String    // "CREDENTIAL_STUFFING" | "IMPOSSIBLE_VELOCITY" | "MASS_SCRAPING" | "PRIVILEGE_ABUSE"
  severity         String    // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  targetUserId     String?
  sourceIp         String
  details          String    // JSON stringified telemetry context
  mitigated        Boolean   @default(false)
  mitigationAction String?   // "IP_BLOCKED" | "USER_LOCKED" | "STEP_UP_ENFORCED"
  createdAt        DateTime  @default(now())

  @@index([threatType])
  @@index([severity])
  @@index([sourceIp])
  @@index([createdAt])
  @@map("security_threat_alerts")
}



model Doctor {
  id                     String      @id @default(cuid())
  doctorCode             String      @unique
  fullName               String
  qualification          String?
  specialization         String?
  phone                  String?     @db.VarChar(15)
  email                  String?     @unique
  clinicName             String?
  address                String?
  commissionRate         Decimal?    @db.Decimal(5, 2)
  isActive               Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  availableDays          String?
  availableTime          String?
  consultationFee        Decimal?    @db.Decimal(10, 2)
  department             String?
  designation            String?
  experience             Int?
  licenseExpiry          DateTime?
  licenseNumber          String?
  photoUrl               String?
  signatureUrl           String?
  doctorType             DoctorType? @default(REFERRING_DOCTOR)
  clinicAddress          String?     @db.VarChar(500)
  whatsappNumber         String?     @db.VarChar(15)
  reportDeliveryEmail    Boolean     @default(false)
  reportDeliveryWhatsApp Boolean     @default(false)
  reportDeliveryHardCopy Boolean     @default(false)
  reportDeliveryPortal   Boolean     @default(false)
  enablePortalAccess     Boolean     @default(false)
  bankAccountNumber      String?     @db.VarChar(30)
  bankIfscCode           String?     @db.VarChar(20)
  bankAccountHolderName  String?     @db.VarChar(200)
  registrationNumber     String?

  // ---------- Personal ----------
  title                  String?     @db.VarChar(20)
  gender                 String?     @db.VarChar(20)
  dateOfBirth            DateTime?
  languages              String?     @db.VarChar(300)
  experienceYears        Int?
  notes                  String?

  // ---------- Contact / Address ----------
  city                   String?     @db.VarChar(100)
  state                  String?     @db.VarChar(100)
  pincode                String?     @db.VarChar(10)

  // ---------- Regulatory / Statutory ----------
  panNumber              String?     @db.VarChar(10)
  gstin                  String?     @db.VarChar(15)
  registrationCouncil    String?     @db.VarChar(100)
  registrationExpiry     DateTime?
  registrationCertificateUrl String?

  // ---------- Financial / Commission ----------
  commissionType         CommissionType @default(PERCENTAGE)
  commissionFlatAmount   Decimal?    @db.Decimal(10, 2)
  commissionCategoryRules Json?
  payoutCycle            PayoutCycle @default(MONTHLY)
  upiId                  String?     @db.VarChar(100)
  bankName               String?     @db.VarChar(150)
  cancelledChequeUrl     String?

  // ---------- Organisation (Hospital / Clinic partner) ----------
  organizationId         String?

  // ---------- Digital signature governance ----------
  signatureApprovedAt    DateTime?
  signatureApprovedById  String?

  // ---------- Soft delete / Archive ----------
  isArchived             Boolean     @default(false)
  archivedAt             DateTime?
  archivedById           String?
  archiveReason          String?     @db.VarChar(500)

  orders                 Order[]
  patients               Patient[]
  organization           DoctorOrganization?  @relation(fields: [organizationId], references: [id])
  commissionLedger       DoctorCommissionEntry[]
  payouts                DoctorPayout[]
  documents              DoctorDocument[]

  @@index([fullName])
  @@index([specialization])
  @@index([isActive])
  @@index([doctorType])
  @@index([city])
  @@index([organizationId])
  @@index([isArchived])
  @@index([registrationNumber])
  @@index([phone], map: "doctors_phone_idx")
  @@map("doctors")
}

// =======================================================
// DOCTOR ORGANIZATION (Hospital / Clinic / Lab partner)
// =======================================================

model DoctorOrganization {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  organizationType OrganizationType @default(CLINIC)
  contactPerson  String?  @db.VarChar(200)
  phone          String?  @db.VarChar(15)
  email          String?
  address        String?
  city           String?  @db.VarChar(100)
  state          String?  @db.VarChar(100)
  pincode        String?  @db.VarChar(10)
  gstin          String?  @db.VarChar(15)
  panNumber      String?  @db.VarChar(10)
  commissionRate Decimal? @db.Decimal(5, 2)
  payoutCycle    PayoutCycle @default(MONTHLY)
  bankAccountNumber String? @db.VarChar(30)
  bankIfscCode   String?  @db.VarChar(20)
  bankAccountHolderName String? @db.VarChar(200)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  doctors        Doctor[]

  @@index([name])
  @@index([organizationType])
  @@map("doctor_organizations")
}

// =======================================================
// DOCTOR COMMISSION LEDGER
// One row per PAID order -> commission earned.
// Single source of truth for "Pending vs Settled".
// =======================================================

model DoctorCommissionEntry {
  id               String   @id @default(cuid())
  doctorId         String
  orderId          String
  payoutId         String?
  referralDate     DateTime @default(now())
  periodKey        String   @db.VarChar(7) // YYYY-MM
  baseAmount       Decimal  @db.Decimal(12, 2)
  commissionRate   Decimal  @db.Decimal(5, 2)
  commissionType   CommissionType @default(PERCENTAGE)
  commissionAmount Decimal  @db.Decimal(12, 2)
  status           CommissionStatus @default(PENDING)
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  doctor           Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payout           DoctorPayout? @relation(fields: [payoutId], references: [id])

  @@unique([orderId])
  @@index([doctorId, status])
  @@index([periodKey])
  @@index([payoutId])
  @@map("doctor_commission_entries")
}

// =======================================================
// DOCTOR PAYOUTS (settlement vouchers)
// =======================================================

model DoctorPayout {
  id            String   @id @default(cuid())
  voucherNumber String   @unique
  doctorId      String
  grossAmount   Decimal  @db.Decimal(12, 2)
  tdsPercentage Decimal  @default(0) @db.Decimal(5, 2)
  tdsAmount     Decimal  @default(0) @db.Decimal(12, 2)
  netPaid       Decimal  @db.Decimal(12, 2)
  paymentMode   String   @db.VarChar(30)
  refNumber     String?
  payoutDate    DateTime
  periodKey     String?  @db.VarChar(7)
  remarks       String?
  status        CommissionStatus @default(SETTLED)
  settledById   String?
  createdAt     DateTime @default(now())
  doctor        Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  entries       DoctorCommissionEntry[]

  @@index([doctorId])
  @@index([payoutDate])
  @@map("doctor_payouts")
}

// =======================================================
// DOCTOR DOCUMENTS (registration certificate, cheque ...)
// =======================================================

model DoctorDocument {
  id           String   @id @default(cuid())
  doctorId     String
  documentType String   @db.VarChar(60)
  fileName     String?  @db.VarChar(255)
  mimeType     String?  @db.VarChar(120)
  sizeBytes    Int?
  fileData     String?
  uploadedById String?
  createdAt    DateTime @default(now())
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("doctor_documents")
}

model Patient {
  id                           String               @id @default(cuid())
  uhid                         String               @unique
  firstName                    String
  lastName                     String
  gender                       Gender
  dateOfBirth                  DateTime?
  age                          Int?
  ageMonth                     Int?
  ageDay                       Int?
  phone                        String?              @db.VarChar(15)
  email                        String?
  bloodGroup                   String?
  address                      String?
  city                         String?
  state                        String?
  pincode                      String?              @db.VarChar(10)
  emergencyContact             String?              @db.VarChar(15)
  referredById                 String?
  createdById                  String?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  emergencyContactName         String?
  emergencyContactRelationship String?
  fastingStatus                String?
  insuranceNumber              String?
  insuranceProvider            String?
  nationalId                   String?
  isActive                     Boolean              @default(true)
  middleName                   String?
  alternatePhone               String?              @db.VarChar(15)
  landmark                     String?
  country                      String?              @default("India")
  emergencyContactAddress      String?
  height                       Float?
  weight                       Float?
  bmi                          Float?
  aadhaarNumber                String?
  panNumber                    String?
  patientType                  String?              @default("GENERAL")
  maritalStatus                String?
  occupation                   String?
  nationality                  String?              @default("Indian")
  allergies                    Json?
  chronicDiseases              Json?
  currentMedications           Json?
  insuranceGroupNumber         String?
  insuranceExpiryDate          DateTime?
  photoUrl                     String?
  preferredLanguage            String?              @default("ENGLISH")
  preferredCommunicationMethod String?
  communicationPreference      Json?
  consentForTreatment          Boolean              @default(false)
  consentForDataSharing        Boolean              @default(false)
  consentForMarketing          Boolean              @default(false)
  familyHeadId                 String?
  relationshipToHead           String?
  notes                        String?
  isDraft                      Boolean              @default(false)
  registrationSource           String?              @default("WALK_IN")
  referralSource               String?
  verificationStatus           String?              @default("UNVERIFIED")
  phoneVerified                Boolean              @default(false)
  emailVerified                Boolean              @default(false)
  kycVerified                  Boolean              @default(false)
  qrCode                       String?
  abhaNumber                   String?              @db.VarChar(20)
  abhaAddress                  String?              @db.VarChar(100)
  healthIdNumber               String?              @db.VarChar(20)
  aadhaarReferenceToken        String?              // Encrypted Aadhaar reference
  abhaStatus                   String               @default("UNLINKED")
  abhaLinkedAt                 DateTime?
  formStep                     Int?
  formProgress                 Int?
  lastEditedSection            String?
  kycVerifiedAt                DateTime?
  kycVerifiedById              String?

  // ── EMPI Capability 1: Probabilistic Deduplication Engine ──────────────────
  /// SHA-256 blind-index of normalised phone for exact-match dedup (+35 pts)
  phoneHash                    String?              @db.VarChar(64)
  /// Double Metaphone primary code for Indian phonetic matching
  phoneticPrimary              String?              @db.VarChar(20)
  /// Double Metaphone alternate code
  phoneticAlternate            String?              @db.VarChar(20)

  // ── Capability 2: Household / Family Shared-Phone Architecture ─────────────
  /// FK to HouseholdGroup (multiple patients can share one phone number)
  householdGroupId             String?
  /// Relation of this patient to the primary holder of the household phone
  familyRelation               FamilyRelation?      @default(SELF)
  /// Allow head-of-family to draw from their advance wallet for this member
  allowFamilyWalletDrawdown    Boolean              @default(false)

  // ── Capability 5: Break-Glass VIP / Confidential Patient Shield ────────────
  confidentialityLevel         ConfidentialityLevel @default(STANDARD)
  /// Alias displayed on worklists when level = VIP_MASKED | RESTRICTED_SENSITIVE
  confidentialAlias            String?              @db.VarChar(50)

  // ── Capability 5: Zero-Downtime Encryption Key Rotation ────────────────────
  encryptionKeyVersion         Int                  @default(1)

  // ── Capability 6: ABDM Scan & Share fast-track token ──────────────────────
  /// Short-lived token returned by ABDM gateway after Scan & Share
  abhaToken                    String?

  abdm_care_contexts           abdm_care_contexts[]
  abdm_consents                abdm_consents[]
  breakGlassLogs               BreakGlassAccessLog[]
  clinicalProfile              PatientClinicalProfile?
  communications               CommunicationLog[]
  empiReviewQueues             EmpiReviewQueue[]
  householdGroup               HouseholdGroup?      @relation(fields: [householdGroupId], references: [id])
  orders                       Order[]
  advances                     PatientAdvance[]
  consents                     PatientConsent[]     @relation("PatientConsents")
  historyEntries               PatientHistoryEntry[] @relation("PatientHistory")
  medicalHistories             PatientMedicalHistory[] @relation("PatientMedicalHistories")
  verifications                PatientVerification[] @relation("PatientVerifications")
  wallet                       PatientWallet?
  createdBy                    User?                @relation("PatientCreator", fields: [createdById], references: [id])
  familyHead                   Patient?             @relation("FamilyHead", fields: [familyHeadId], references: [id])
  familyMembers                Patient[]            @relation("FamilyHead")
  kycVerifiedBy                User?                @relation("PatientKycVerifier", fields: [kycVerifiedById], references: [id])
  referredBy                   Doctor?              @relation(fields: [referredById], references: [id])
  reports                      Report[]
  results                      Result[]             @relation("ResultPatient")
  trackingHistory              SampleTrackingHistory[]
  samples                      Sample[]
  whatsappConversations        WhatsAppConversation[] @relation("ConversationPatient")
  whatsappIncomingMessages     WhatsAppIncomingMessage[]
  whatsappScheduledMessages    WhatsAppScheduledMessage[]

  @@index([phone])
  @@index([phoneHash])                    // EMPI: exact phone blind-index
  @@index([phoneticPrimary])              // EMPI: phonetic name lookup
  @@index([firstName, lastName])
  @@index([referredById])
  @@index([createdById])
  @@index([familyHeadId])
  @@index([householdGroupId])
  @@index([confidentialityLevel])
  @@index([isDraft])
  @@index([isActive])
  @@index([createdAt])
  @@index([abhaNumber])
  @@index([abhaAddress])
  @@index([kycVerifiedById])
  @@map("patients")
}

// ════════════════════════════════════════════════════════════════════════════
// ENTERPRISE EMPI — Capability 2: Household / Family Shared-Phone Group
// ════════════════════════════════════════════════════════════════════════════

model HouseholdGroup {
  id                     String    @id @default(cuid())
  /// SHA-256 of the normalised (+91XXXXXXXXXX) phone number
  primaryPhoneHash       String    @unique
  /// UHID of the registered "head" of this household
  primaryHolderPatientId String?
  /// When true, head's advance wallet covers all family members' bills
  allowFamilyWalletSharing Boolean @default(false)
  patients               Patient[]
  createdAt              DateTime  @default(now())

  @@index([primaryPhoneHash])
  @@map("household_groups")
}

// ════════════════════════════════════════════════════════════════════════════
// ENTERPRISE EMPI — Capability 1: Probabilistic Dedup Review Queue
// ════════════════════════════════════════════════════════════════════════════

/// Created when EMPI score is 60–84 (POTENTIAL_DUPLICATE). A data steward
/// reviews and either merges or dismisses the flag.
model EmpiReviewQueue {
  id               String       @id @default(cuid())
  /// The newly-created patient that triggered the match
  incomingPatientId String
  /// The existing candidate patient that scored a potential duplicate
  candidatePatientId String
  empiScore        Int
  empiDecision     EmpiDecision @default(POTENTIAL_DUPLICATE_QUEUE)
  scoreBreakdown   Json         // {phone: 35, phonetic: 28, dob: 20, gender: 10, pincode: 5}
  reviewedById     String?
  reviewedAt       DateTime?
  resolutionNotes  String?
  isResolved       Boolean      @default(false)
  createdAt        DateTime     @default(now())

  incomingPatient  Patient      @relation(fields: [incomingPatientId], references: [id], onDelete: Cascade)

  @@index([incomingPatientId])
  @@index([candidatePatientId])
  @@index([isResolved])
  @@index([empiDecision])
  @@map("empi_review_queue")
}

// ════════════════════════════════════════════════════════════════════════════
// ENTERPRISE EMPI — Capability 3: Longitudinal Clinical Modifiers
// ════════════════════════════════════════════════════════════════════════════

/// ISO 15189:2022-grade clinical modifiers that alter reference range
/// interpretation for specific tests (TSH, PT/INR, Neonatal Bilirubin …)
model PatientClinicalProfile {
  id                    String          @id @default(cuid())
  patientId             String          @unique
  patient               Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Neonatal / NICU fields (Bhutani Nomogram bilirubin by hours-of-life)
  /// Precise birth timestamp – required for NICU hour-based bilirubin nomograms
  birthTimestamp        DateTime?
  /// Gestational age at delivery; <37 w = premature; affects neonatal ref ranges
  gestationalAgeWeeks   Int?
  birthWeightGrams      Int?

  // Obstetric / Pregnancy
  pregnancyStatus       PregnancyStatus @default(NOT_APPLICABLE)
  /// Last Menstrual Period date – used to derive trimester automatically
  lmpDate               DateTime?

  // Blood Group (once cross-match verified, locked with badge)
  bloodGroup            String?
  /// Staff ID who cross-matched & verified the blood group
  bloodGroupVerifiedBy  String?
  bloodGroupVerifiedAt  DateTime?

  // Chronic therapy flags (change delta/panic limits in Module 07/08)
  /// Warfarin/Heparin: INR therapeutic target 2.5–3.5 (not 0.9–1.1)
  isOnAnticoagulants    Boolean         @default(false)
  /// Affects Creatinine/Urea delta-check thresholds
  isOnDialysis          Boolean         @default(false)
  /// Post-transplant immunosuppression; may alter CBC and chemistry ranges
  isTransplantRecipient Boolean         @default(false)

  // Allergy & ICD-10 coded chronic conditions
  knownAllergies        String[]        // free-text or SNOMED-CT codes
  chronicConditions     String[]        // ICD-10 / SNOMED-CT codes

  updatedAt             DateTime        @updatedAt

  @@map("patient_clinical_profiles")
}

// ════════════════════════════════════════════════════════════════════════════
// ENTERPRISE EMPI — Capability 4: Event-Sourced Unmerge / Split
// ════════════════════════════════════════════════════════════════════════════

/// Records every MPI merge so a SUPER_ADMIN can fully reverse it without
/// touching records that were created AFTER the merge occurred.
model PatientMergeLog {
  id               String               @id @default(cuid())
  sourcePatientId  String
  targetPatientId  String
  mergedByUserId   String
  mergeReason      String?
  mergedAt         DateTime             @default(now())
  /// Full JSON snapshot of the source patient row before merge
  snapshot         PatientMergeSnapshot?

  @@index([sourcePatientId])
  @@index([targetPatientId])
  @@index([mergedByUserId])
  @@map("patient_merge_logs")
}

model PatientMergeSnapshot {
  id                   String    @id @default(cuid())
  mergeLogId           String    @unique
  mergeLog             PatientMergeLog @relation(fields: [mergeLogId], references: [id], onDelete: Cascade)
  /// Complete JSON row of sourcePatient as it was before merge
  sourcePatientBackup  Json
  migratedOrderIds     String[]
  migratedSampleIds    String[]
  migratedInvoiceIds   String[]
  migratedReceiptIds   String[]
  transferredWalletAmt Decimal   @default(0) @db.Decimal(12, 2)
  /// Set to true once POST /patients/merge/:mergeLogId/unmerge has run
  isReverted           Boolean   @default(false)
  revertedAt           DateTime?
  revertedByUserId     String?
  createdAt            DateTime  @default(now())

  @@map("patient_merge_snapshots")
}

// ════════════════════════════════════════════════════════════════════════════
// ENTERPRISE EMPI — Capability 5: Break-Glass VIP / Confidential Access Log
// ════════════════════════════════════════════════════════════════════════════

/// Written every time a clinician clicks "Break-Glass Emergency Access" to
/// reveal the true identity of a VIP_MASKED or RESTRICTED_SENSITIVE patient.
/// Also sends a real-time WebSocket alert to the Chief Pathologist.
model BreakGlassAccessLog {
  id             String   @id @default(cuid())
  patientId      String
  accessedById   String
  clinicalReason String
  ipAddress      String   @db.VarChar(45)
  /// Temporary 30-minute unmasked window for that specific clinician
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, accessedById])
  @@index([expiresAt])
  @@map("break_glass_access_logs")
}

model TestCategory {
